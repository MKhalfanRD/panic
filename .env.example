HTTP_PORT=8081
APP_URL=http://localhost:8081
APP_ENV=development

# Kosongkan DB_DSN untuk memakai kolom di bawah. Database dibuat otomatis
# jika user MySQL berhak menjalankan CREATE DATABASE.
DB_DSN=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=panic

JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN_HOURS=24

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Dipakai sekali, saat database masih kosong.
SEED_PASSWORD=panic-dev
